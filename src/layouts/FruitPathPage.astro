---
import type { CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import FruitPathForestLinks from "@components/FruitPathForestLinks.astro";
import {
  ARTICLE_PROGRESS_STORAGE_KEY,
  getArticleProgressKey,
} from "@lib/articleProgress";

type Props = {
  entry: CollectionEntry<"fruit-path">;
  backHref?: string;
  backLabel?: string;
};

const {
  entry,
  backHref = "/fruit-path",
  backLabel = "Fruit Paths",
} = Astro.props as Props;

const data = entry?.data;
const shiftData = data?.shift;
const treeData = data?.tree;

const treeTitle = treeData?.title ?? data?.title;
const treeSummary = treeData?.summary ?? data?.summary;

const pathwayLabel = data?.label;
const fallbackLabel = shiftData
  ? `${shiftData.fruit ?? shiftData.title} <-> ${treeTitle ?? "Truth"}`
  : treeTitle ?? "Fruit Path";

const title = pathwayLabel ?? fallbackLabel;
const description =
  shiftData?.description ??
  treeSummary ??
  "Integrated pathway overview.";
const articleTags = Array.from(
  new Set([...(data?.tags ?? []), ...(shiftData?.tags ?? [])]),
);

const { Content } = await entry.render();
const pathwayId = data?.pathwayId ?? entry.slug;
const articleProgressKey = getArticleProgressKey(entry.collection, entry.slug);
const articleMeta = {
  key: articleProgressKey,
  collection: entry.collection,
  slug: entry.slug,
  href: `/fruit-path/${pathwayId}`,
  title,
};
---

<PageLayout
  title={title}
  description={description}
  seoTitle={data?.seoTitle}
  seoDescription={data?.seoDescription}
  pageType="article"
  schemaType="Article"
  publishedTime={data?.date}
  section="Fruit Paths"
  tags={articleTags}
>
  <TopLayout>
    <div class="animate">
      <a
        href={backHref}
        class="group relative z-[70] flex min-h-11 w-fit touch-manipulation items-center gap-1.5 rounded border border-ash/20 px-2.5 py-2 text-sm transition-colors duration-300 ease-in-out hover:border-ember/50 hover:bg-ember/10 hover:text-ink dark:border-bone/15 dark:hover:bg-ember/10 dark:hover:text-bone"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-current"
        >
          <line
            x1="19"
            y1="12"
            x2="5"
            y2="12"
            class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-300 ease-in-out"
          />
          <polyline
            points="12 19 5 12 12 5"
            class="translate-x-1 group-hover:translate-x-0 transition-all duration-300 ease-in-out"
          />
        </svg>
        <div class="w-full transition-colors duration-300 ease-in-out">
          Back to {backLabel}
        </div>
      </a>

      <div class="mt-10">
        <div class="text-xs uppercase tracking-[0.2em] text-ember">Fruit Path</div>
        <h1 class="mt-3 text-3xl font-semibold text-ink dark:text-bone">
          {title}
        </h1>
        {description && (
          <p class="mt-2 max-w-prose text-balance text-lg text-ash dark:text-zinc-400">
            {description}
          </p>
        )}

        {shiftData?.systemLabel && (
          <div class="mt-4 inline-flex items-center gap-2 text-xs uppercase tracking-wide text-ash dark:text-zinc-300">
            <span class="rounded-full border border-ember/40 px-2 py-1 text-ink dark:text-bone">System</span>
            <span>{shiftData.systemLabel}</span>
          </div>
        )}

        <div class="mt-5 flex flex-wrap gap-2 text-xs uppercase tracking-[0.18em]">
          <span class="rounded-full border border-ember/30 bg-ember/10 px-3 py-1 text-ink dark:border-ember/25 dark:bg-ember/10 dark:text-bone">
            Fruit
          </span>
          <span class="rounded-full border border-moss/30 bg-moss/10 px-3 py-1 text-ink dark:border-moss/25 dark:bg-moss/10 dark:text-bone">
            Root
          </span>
          <span
            data-reading-status={articleProgressKey}
            hidden
            class="items-center gap-2 rounded-full border border-ash/20 bg-paper/70 px-3 py-1 text-xs font-semibold normal-case tracking-normal text-ash dark:border-bone/15 dark:bg-zinc-900/70 dark:text-zinc-300"
          >
            <span
              data-reading-status-dot
              class="size-2 rounded-full bg-ash/50"
              aria-hidden="true"
            ></span>
            <span data-reading-status-label>Progress saved</span>
          </span>
        </div>
      </div>
    </div>
  </TopLayout>

  <BottomLayout>
    <div class="animate">
      <article
        data-reading-progress-article={articleProgressKey}
        class="mt-6 border-t border-ember/20 pt-6 dark:border-ember/20"
      >
        {Content ? <Content /> : null}
      </article>
      <div data-reading-progress-end={articleProgressKey}></div>

      {pathwayId && (
        <div class="mt-10 space-y-6">
          <FruitPathForestLinks pathwayId={pathwayId} />
        </div>
      )}

      <!-- Production feedback integration omitted. -->
    </div>
  </BottomLayout>

  <script is:inline define:vars={{ articleMeta, ARTICLE_PROGRESS_STORAGE_KEY }}>
    (() => {
      const article = document.querySelector(
        `[data-reading-progress-article="${articleMeta.key}"]`,
      );
      const endMarker = document.querySelector(
        `[data-reading-progress-end="${articleMeta.key}"]`,
      );

      const readProgressStore = () => {
        try {
          const raw = window.localStorage.getItem(ARTICLE_PROGRESS_STORAGE_KEY);
          return raw ? JSON.parse(raw) : {};
        } catch {
          return {};
        }
      };

      const writeProgressStore = (store) => {
        try {
          window.localStorage.setItem(
            ARTICLE_PROGRESS_STORAGE_KEY,
            JSON.stringify(store),
          );
        } catch {
          // Progress is helpful but nonessential.
        }
      };

      const updateReadingStatus = (record) => {
        const badges = document.querySelectorAll(
          `[data-reading-status="${articleMeta.key}"]`,
        );

        badges.forEach((badge) => {
          const label = badge.querySelector("[data-reading-status-label]");
          const dot = badge.querySelector("[data-reading-status-dot]");
          const isComplete = Boolean(record?.completedAt);

          badge.hidden = false;
          badge.classList.add("inline-flex");
          badge.classList.toggle("border-moss/35", isComplete);
          badge.classList.toggle("bg-moss/10", isComplete);
          badge.classList.toggle("text-moss", isComplete);
          badge.classList.toggle("dark:text-moss", isComplete);

          if (label) {
            label.textContent = isComplete ? "Completed" : "In progress";
          }

          if (dot) {
            dot.classList.toggle("bg-moss", isComplete);
            dot.classList.toggle("bg-starlight", !isComplete);
          }
        });
      };

      const getScrollDepth = () => {
        if (!article) return 0;

        const rect = article.getBoundingClientRect();
        const articleHeight = Math.max(article.scrollHeight, rect.height, 1);
        const viewed = Math.min(
          Math.max(window.innerHeight - rect.top, 0),
          articleHeight,
        );

        return Math.max(0, Math.min(1, viewed / articleHeight));
      };

      const saveProgress = ({ complete = false } = {}) => {
        const store = readProgressStore();
        const existing = store[articleMeta.key] ?? {};
        const now = new Date().toISOString();
        const record = {
          ...existing,
          ...articleMeta,
          lastVisitedAt: now,
          maxScroll: Math.max(existing.maxScroll ?? 0, getScrollDepth()),
          completedAt: complete ? existing.completedAt ?? now : existing.completedAt,
        };

        store[articleMeta.key] = record;
        writeProgressStore(store);
        updateReadingStatus(record);
      };

      if (article) {
        saveProgress();

        let ticking = false;
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(() => {
              saveProgress();
              ticking = false;
            });
          },
          { passive: true },
        );

        if (endMarker && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  saveProgress({ complete: true });
                  observer.disconnect();
                }
              });
            },
            { rootMargin: "0px 0px -12% 0px" },
          );

          observer.observe(endMarker);
        }

        window.addEventListener("pagehide", () => saveProgress());
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "hidden") {
            saveProgress();
          }
        });
      }
    })();
  </script>
</PageLayout>
