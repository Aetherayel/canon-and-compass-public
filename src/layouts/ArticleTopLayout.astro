---
import { formatDate, readingTime } from "@lib/utils"
import { getPublishedForestOverviews, type ArticleEntry } from "@lib/content"
import { getArticleProgressKey } from "@lib/articleProgress"

type Props = {
  entry: ArticleEntry
}

const { entry } = Astro.props
const { collection, data, body } = entry
const { title } = data
const summary = data.summary
const date = data.date
const articleProgressKey = getArticleProgressKey(collection, entry.slug)
const isFieldNote =
  collection === "the-clearing" && data.stream === "field-notes";
const isCompassPoint = collection === "compass-points";
// Give a Forest trail its immediate overview as the natural parent link.
const parentForest = collection === "forests"
  ? (await getPublishedForestOverviews()).find(
      (forest) => forest.data.series === ("series" in data ? data.series : undefined),
    )
  : undefined;
// Back link: pretty label + special-case collection routing
const backHref =
  collection === "compass-points" ? `/forests/${data.primaryForest}`
  : collection === "forests" ? (parentForest ? `/forests/${parentForest.slug}` : "/forests")
  : collection === "foundations-of-discernment" ? "/foundations/foundations-of-discernment"
  : collection === "bearings" ? "/foundations"
  : "/the-clearing";
const backLabel =
  isCompassPoint ? "the Forest"
  : collection === "forests" ? (parentForest?.data.cardTitle ?? "Forests")
  : collection === "foundations-of-discernment" ? "Foundations of Discernment"
  : collection === "bearings" ? "The Foundations"
  : "The Clearing";
const accentStyles =
  (collection === "forests" || collection === "compass-points")
    ? {
        hover: "hover:border-pine/50 hover:bg-pine/10 dark:hover:bg-pine/10",
        eyebrow: "text-pine dark:text-moss",
        meta: "text-pine/90 dark:text-moss",
        summary: "border-pine/25 dark:border-pine/25",
      }
    : (collection === "foundations-of-discernment" || collection === "bearings")
        ? {
            hover: "hover:border-fig/50 hover:bg-fig/10 dark:hover:bg-fig/10",
            eyebrow: "text-fig dark:text-fig-light",
            meta: "text-fig dark:text-fig-light",
            summary: "border-fig/25 dark:border-fig/35",
          }
        : {
            hover: "hover:border-starlight/50 hover:bg-starlight/10 dark:hover:bg-starlight/10",
            eyebrow: "text-starlight dark:text-starlight",
            meta: "text-starlight/90 dark:text-starlight",
            summary: "border-starlight/25 dark:border-starlight/25",
          };
const eyebrowLabel =
  isFieldNote
    ? "The Clearing · Field Notes"
    : isCompassPoint ? "The Forests · Compass Point"
    : collection === "forests" ? data.series ?? "Forest Trail"
    : collection === "bearings" ? `The Foundations · ${data.kind === "theology" ? "Theology" : "Worldview"}`
    : collection === "foundations-of-discernment" ? "The Foundations · Guided Study"
    : backLabel;
---

<div>
  <a href={backHref} class={`group relative z-[70] flex min-h-11 w-fit touch-manipulation items-center gap-1.5 rounded border border-ash/20 px-2.5 py-2 text-sm transition-colors duration-300 ease-in-out hover:text-ink dark:border-bone/15 dark:hover:text-bone ${accentStyles.hover}`}>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current">
      <line x1="19" y1="12" x2="5" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
      <polyline points="12 19 5 12 12 5" class="translate-x-1 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
    </svg>
    <div class="w-full transition-colors duration-300 ease-in-out">
      Back to {backLabel}
    </div>
  </a>
  <div class={`mt-10 text-xs uppercase tracking-[0.2em] ${accentStyles.eyebrow}`}>
    {eyebrowLabel}
  </div>
  <div class={`mt-4 flex flex-wrap gap-3 text-sm uppercase ${accentStyles.meta}`}>
    {date && (
    <div class="flex items-center gap-2">
      <svg class="size-5 stroke-current">
        <use href="/ui.svg#calendar"/>
      </svg>
      {formatDate(date)}
    </div>
    )}
    <div class="flex items-center gap-2">
      <svg class="size-5 stroke-current">
        <use href="/ui.svg#book-open"/>
      </svg>
      {readingTime(body)}
    </div>
    <div
      data-reading-status={articleProgressKey}
      hidden
      class="items-center gap-2 rounded-full border border-ash/20 bg-paper/70 px-3 py-1 text-xs font-semibold normal-case tracking-normal text-ash dark:border-bone/15 dark:bg-zinc-900/70 dark:text-zinc-300"
    >
      <span
        data-reading-status-dot
        class="size-2 rounded-full bg-ash/50"
        aria-hidden="true"
      ></span>
      <span data-reading-status-label>Progress saved</span>
    </div>
  </div>
  <h1 class="mt-2 text-3xl font-semibold text-ink dark:text-bone">
    {title}
  </h1>
  <div class={`mt-3 max-w-prose border-l-2 pl-4 text-ash dark:text-zinc-300 ${accentStyles.summary}`}>
    {summary}
  </div>
</div>
