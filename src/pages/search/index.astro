---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import Search from "@components/Search";
import { SEARCH } from "@consts";
import { toCardEntry } from "@lib/cardEntries";
import { getCompassPoints } from "@lib/compassPoints";
import { isPublished } from "@lib/publication";

const posts = (await getCollection("fruit-path")).filter(isPublished);

const clearing = (await getCollection("the-clearing")).filter(isPublished);

const forests = (await getCollection("forests")).filter(isPublished);

const bearings = (await getCollection("bearings")).filter(isPublished);
const compassPoints = (await getCompassPoints()).filter(isPublished);

const discernmentEntries = (await getCollection("foundations-of-discernment")).filter(
  isPublished,
);

const data = [...posts, ...clearing, ...forests, ...bearings, ...compassPoints, ...discernmentEntries] as CollectionEntry<
  | "fruit-path"
  | "the-clearing"
  | "forests"
  | "foundations-of-discernment"
  | "bearings"
  | "compass-points"
>[];

const cardData = data.map((entry) => toCardEntry(entry));
---

<PageLayout
  title={SEARCH.TITLE}
  description={SEARCH.DESCRIPTION}
  schemaType="SearchResultsPage"
  robots="noindex,follow"
  section="Search"
>
  <TopLayout>
    <div class="animate page-heading">
      {SEARCH.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Search client:load data={cardData} />
    </div>
  </BottomLayout>
</PageLayout>
