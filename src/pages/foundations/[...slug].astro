---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro";
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro";
import { isPublished } from "@lib/publication";

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;
const entry = (await getCollection("bearings"))
  .filter(isPublished)
  .find((candidate) => candidate.slug === slug);
if (!entry) return Astro.redirect("/foundations");
---

<PageLayout
  title={entry.data.title}
  description={entry.data.summary}
  seoTitle={entry.data.seoTitle}
  seoDescription={entry.data.seoDescription}
  pageType="article"
  schemaType="Article"
  publishedTime={entry.data.date}
  section="The Foundations"
  tags={entry.data.tags}
>
  <TopLayout><div class="animate"><ArticleTopLayout entry={entry}/></div></TopLayout>
  <BottomLayout><div class="animate"><ArticleBottomLayout entry={entry}/></div></BottomLayout>
</PageLayout>
